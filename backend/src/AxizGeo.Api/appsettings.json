{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "TelemetryRules": {
    "MaxAccuracyMeters": 50,
    "DefaultCorridorMeters": 150,
    "NoSignalMinutes": 3,
    "ConsecutiveDeviationsRequired": 2
  }
}
