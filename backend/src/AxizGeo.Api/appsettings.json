{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "axiz-geo-api",
    "Audience": "axiz-geo-web",
    "ExpirationMinutes": 480
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "TelemetryRules": {
    "MaxAccuracyMeters": 50,
    "DefaultCorridorMeters": 150,
    "NoSignalMinutes": 3,
    "ConsecutiveDeviationsRequired": 2
  }
}
